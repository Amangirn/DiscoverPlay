# Copy this file to .env and fill in your own values.
# Never commit .env or share your secret keys.

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/discoverplay
JWT_SECRET=replace_with_a_long_random_secret

# Deployed DiscoverPlay frontend origin. Add any other frontend origins as comma-separated values.
FRONTEND_ORIGIN=https://discoverplay.onrender.com

# Razorpay TEST MODE credentials (use rzp_test_... keys while developing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
